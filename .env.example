# Copy to .env and replace POSTGRES_PASSWORD with a locally generated value.
POSTGRES_DB=steadwork
POSTGRES_USER=steadwork
POSTGRES_PASSWORD=replace-with-a-random-local-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional overrides for local Compose OpenTelemetry export.
STEADWORK_ENVIRONMENT=development
STEADWORK_VERSION=local
STEADWORK_SEED_OBSERVABILITY_DATA=true
OTEL_SERVICE_NAME=steadwork-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Keep this empty for the local self-hosted stack. Store remote tokens only in ignored .env files.
OTEL_EXPORTER_OTLP_HEADERS=
