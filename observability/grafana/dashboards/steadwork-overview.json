{
  "id": null,
  "uid": "steadwork-overview",
  "title": "Steadwork service overview",
  "tags": [
    "steadwork",
    "application-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_duration_milliseconds_count{service_name=\"steadwork-api\"}, deployment_environment_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "development",
          "value": "development"
        },
        "sort": 1
      },
      {
        "name": "version",
        "label": "Deployed version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\"}, service_version)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "local",
          "value": "local"
        },
        "sort": 1
      },
      {
        "name": "origin",
        "label": "Activity origin",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(steadwork_business_events_rolling, origin)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "5xx request ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",http_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])), 0.000001)) and on() (sum(rate(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx ratio",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "p95 request duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_duration_milliseconds_bucket{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))) and on() (sum(rate(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval])) > 0)",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "95th percentile request duration from Django HTTP server metrics, in milliseconds."
    },
    {
      "id": 4,
      "title": "User actions by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action, outcome) (rate(steadwork_user_action_total{deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "{{action}} \u00b7 {{outcome}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Recent user-action logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"steadwork-api\", deployment_environment_name=~\"$environment\", service_version=~\"$version\"} |= \"user_action_\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "description": "Recent user action logs filtered by the dashboard environment and deployed version selectors."
    },
    {
