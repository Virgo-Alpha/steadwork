          "refId": "A",
          "expr": "sum by (event, origin) (steadwork_business_events_rolling{deployment_environment_name=~\"$environment\",service_version=~\"$version\",origin=~\"$origin\",window=\"24h\"})",
          "legendFormat": "{{event}} \u00b7 {{origin}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
