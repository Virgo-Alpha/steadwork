    {
      "id": 15,
      "title": "30-day request success SLI",
      "type": "stat",
      "description": "1 - (5xx requests / eligible requests) over 30 days. All requests except 5xx, including 4xx responses, count as successful. No eligible requests returns no data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - ((sum(increase(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\",http_status_code=~\"5..\"}[30d])) or vector(0)) / clamp_min(sum(increase(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[30d])), 1))) and (sum(increase(http_server_duration_milliseconds_count{service_name=\"steadwork-api\",deployment_environment_name=~\"$environment\",service_version=~\"$version\"}[30d])) > 0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 16,
      "title": "Successful tracked actions (rolling 24h)",
      "type": "timeseries",
      "description": "Persisted successful registration, login, job-status, application, withdrawal, and review events. Demo and live event history are separated by origin. This is distinct from the live request outcome counter.",
